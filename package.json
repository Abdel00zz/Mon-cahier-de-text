{
  "name": "cahier-de-textes-interactif",
  "private": true,
  "version": "1.2.3",
  "androidVersionCode": 5,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:android:web": "vite build --mode android",
    "android:sync": "npm run build:android:web && cap sync android",
    "android:apk": "node scripts/android/build-apk.mjs",
    "android:release": "node scripts/android/build-apk.mjs --release",
    "android:smoke": "node scripts/android/smoke-test.mjs",
    "android:signing": "node scripts/android/prepare-signing.mjs",
    "android:signing:backup": "node scripts/android/backup-signing.mjs",
    "android:signing:restore": "node scripts/android/restore-signing.mjs",
    "android:version": "node scripts/android/bump-version.mjs",
    "android:open": "cap open android",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "optimize": "vite build --mode production",
    "lint": "tsc --noEmit",
    "check:unused": "knip --no-progress",
    "check": "npm run check:data && npm run check:architecture && npm run check:unused && npm run check:i18n && npm run build",
    "check:architecture": "tsc --noEmit --noUnusedLocals --noUnusedParameters && node scripts/validation/check-architecture.mjs",
    "check:data": "node scripts/validation/validate-assessment-data.mjs && tsx scripts/validation/validate-predefined-content.ts && tsx scripts/validation/validate-official-curriculum.ts",
    "test": "node tests/run-all.mjs",
    "test:pilotage": "tsx tests/test-curriculum-session-alerts.ts && tsx tests/test-chapter-lifecycle.ts",
    "bench:pilotage": "tsx scripts/benchmarks/benchmark-pilotage.ts",
    "bench:json": "tsx scripts/benchmarks/benchmark-json.ts",
    "check:i18n": "node scripts/validation/audit-i18n.mjs",
    "test:notifications": "tsx tests/test-notification-mechanisms.ts",
    "test:pwa": "tsx tests/test-pwa-mobile.ts",
    "test:admin-sync": "tsx tests/test-admin-sync.ts",
    "test:editor": "node tests/run-editor-tests.mjs",
    "test:modals": "tsx tests/test-modal-motion.ts",
    "test:guide": "tsx tests/test-guide.ts"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/network": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@upstash/redis": "^1.38.0",
    "capacitor-webview-print": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "framer-motion": "^12.23.12",
    "immer": "^10.1.1",
    "katex": "^0.18.9",
    "lucide-react": "^1.31.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "use-immer": "^0.11.0",
    "web-push": "^3.6.7",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.28.2",
    "knip": "^6.26.0",
    "tailwindcss": "^4.3.2",
    "terser": "^5.44.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}

 const x=S.find(s=>s.id===curC);if(!x)return;const it=A[x.id]||[];
 $("#chero").style.cssText=vars(x.c);$("#pcl").textContent="قسم "+x.lv+" "+(x.tr?x.tr+" ":"")+x.g;
 $("#acc").innerHTML=CATS.map(([k,t,ic],i)=>{const rs=it.filter(r=>r.k===k&&!r.p);
  return `<section class="ac${open[k]?" open":""}" data-k="${k}" style="${vars(i)};--i:${i}"><button class="ac-h" aria-expanded="${!!open[k]}"><span class="ci">${I(ic)}</span><span class="ac-t">${t}</span>${rs.length?`<span class="cnt">${rs.length}</span>`:""}<span class="chv">${I("chevd")}</span></button><div class="ac-b"><div class="ac-i"><div class="rs">${rs.length?rs.map(r=>row(r)+it.filter(c=>c.p===r.id).map(c=>row(c,1)).join("")).join(""):`<p class="no">لا يوجد محتوى بعد.</p>`}</div></div></div></section>`}).join("")}
function openC(id){
 curC=id;renderCls();$("#cls").inert=false;$("#cls").classList.add("on");
 $("#home").inert=$("#fab").inert=true;
 try{history.pushState({c:id},"")}catch(e){}
 $("#pgs").scrollTop=0;setTimeout(()=>$("#px").focus({preventScroll:true}),520)}
function closeC(pop){
 $("#cls").classList.remove("on");$("#cls").inert=true;
 $("#home").inert=$("#fab").inert=false;
 if(!pop&&history.state&&history.state.c)history.back()}
$("#px").onclick=()=>closeC(false);
$("#cls").addEventListener("click",e=>{if(e.target.id==="cls")closeC(false)});
swipe($("#cls"),$("#pgs"),()=>closeC(false));
addEventListener("popstate",()=>closeC(true));
addEventListener("keydown",e=>{if(e.key==="Escape"&&$("#cls").classList.contains("on")&&!document.querySelector("dialog[open]"))closeC(false)});
$("#acc").addEventListener("click",e=>{
 const h=e.target.closest(".ac-h");
 if(h){const s=h.parentNode,o=s.classList.toggle("open");h.setAttribute("aria-expanded",o);open[s.dataset.k]=o;return}
 const b=e.target.closest(".ab");if(!b)return;
 const id=b.closest(".tk").dataset.id,a=b.dataset.a;
 if(a!=="del"){buzz(6);toast((a==="doc"?"الوثيقة":"التلاميذ")+" : قريباً");return}
 const L=A[curC],gone=L.filter(r=>r.id===id||r.p===id);
 A[curC]=L.filter(r=>!gone.includes(r));save();buzz([12,40,12]);renderCls();
 toast("تم الحذف",()=>{A[curC]=L.slice();save();renderCls()})});

/* ── modale assistant : 3 étapes, avance auto, héros qui prend la couleur choisie ── */
let W={};
const cyOf=lv=>CY.findIndex(c=>c[1].includes(lv));
function openWz(x){
 W={id:x&&x.id,step:x?3:1,cy:x?Math.max(0,cyOf(x.lv)):0,lv:x&&x.lv,tr:x&&x.tr,g:x?x.g:1,sub:x?x.sub:"الرياضيات",c:x?x.c:S.length%6,d:x?x.d:null,cus:false,done:x?3:0,an:0};
 drawWz();$("#wz").showModal()}
const nextG=()=>{let g=1;while(S.some(s=>s.id!==W.id&&s.lv===W.lv&&(s.tr||"")===(W.tr||"")&&s.g===g))g++;return g};
const go=n=>{W.step=n;W.an=1;drawWz()};
function to3(){W.g=nextG();W.sub=SUB[W.tr]||"الرياضيات";W.done=Math.max(W.done,2);go(3)}
function drawWz(){
 const cy=W.lv&&cyOf(W.lv)>=0?cyOf(W.lv):W.cy;
 $("#wh").style.cssText=vars(W.step===3?W.c:0);
 $("#wsub").textContent=CY[W.step===1?W.cy:cy][0];$("#wt").textContent=W.id?"تعديل القسم":"إضافة قسم";
 $("#stp").innerHTML=["القسم","الشعبة","رقم الفوج"].map((t,i)=>{const n=i+1,ok=n<W.step&&n<=W.done;
  return `<li><button data-act="st" data-i="${n}" ${n===W.step?'aria-current="step"':""} ${n>W.done+1?"disabled":""} class="${ok?"ok":""}"><i>${ok?I("check"):n}</i>${t}</button></li>`}).join("");
 const tile=(a,v,l,i,on)=>`<button class="tile${on?" on":""}" style="${vars(i%6)}" data-act="${a}" data-v="${v}">${l}<span class="ar">${I("chevl")}</span></button>`;
 let b="",f="";
 if(W.step===1){
  b=`<div class="seg">${CY.map((c,i)=>`<button data-act="cy" data-i="${i}" aria-pressed="${i===W.cy}">${c[0]}</button>`).join("")}</div>
   <div class="lb"><b>القسم</b><button class="lnk" data-act="cus">${W.cus?"المستويات":"مستوى مخصص"}</button></div>`+
   (W.cus?`<div class="cust"><input id="cv" type="text" maxlength="30" placeholder="اسم المستوى" value="${esc(W.lv&&cyOf(W.lv)<0?W.lv:"")}"><button data-act="cgo">متابعة</button></div>`
    :`<div class="tiles">${CY[W.cy][1].map((l,i)=>tile("lv",l,l,i,l===W.lv)).join("")}</div>`);
  f=`<button class="gh" data-act="cx">إلغاء</button>`}
 else if(W.step===2){
  b=`<div class="lb"><b>الشعبة</b></div><div class="tiles col">${TR[W.lv].map((t,i)=>tile("tr",t,t,i+1,t===W.tr)).join("")}</div>`;
  f=`<button class="gh" data-act="cx">إلغاء</button><button class="bk" data-act="bk">رجوع</button>`}
 else{
  b=`<div class="c3" style="${vars(W.c)}"><small>القسم المختار</small><b class="sel">${esc(W.tr||W.lv)}</b>${W.tr&&!W.tr.includes(W.lv)?`<small>${esc(W.lv)}</small>`:""}
   <div class="lb2">رقم الفوج</div>
   <div class="sp"><button data-act="g-" aria-label="إنقاص">${I("minus")}</button><output aria-live="polite">${W.g}</output><button data-act="g+" aria-label="زيادة">${I("plus")}</button></div>
   <p class="hint">يُقترح أول رقم متاح تلقائياً.</p>
   <label class="sj">المادة الدراسية :<select id="sb">${SUBJ.map(s=>`<option${s===W.sub?" selected":""}>${s}</option>`).join("")}</select></label></div>
   <div class="lb2">اللون</div><div class="sw">${PAL.map((_,i)=>`<button class="dotc${i===W.c?" on":""}" style="${vars(i)}" data-act="c" data-i="${i}" aria-label="لون ${i+1}" aria-pressed="${i===W.c}"></button>`).join("")}</div>`;
  f=`<button class="pri" data-act="ok">${W.id?"حفظ":"إنشاء القسم"}${W.id?"":I("plus")}</button><button class="gh" data-act="cx">إلغاء</button><button class="bk" data-act="bk">رجوع</button>`}
 const wb=$("#wb");wb.innerHTML=b;$("#wf").innerHTML=f;
 if(W.an){wb.classList.remove("an");void wb.offsetWidth;wb.classList.add("an");W.an=0;wb.scrollTop=0}}
$("#wz").addEventListener("click",e=>{
 const b=e.target.closest("[data-act]");if(!b)return;const a=b.dataset.act,v=b.dataset.v,i=+b.dataset.i;
 if(a==="cx")$("#wz").close();
 else if(a==="cy"){W.cy=i;drawWz()}
 else if(a==="cus"){W.cus=!W.cus;drawWz();if(W.cus)$("#cv").focus()}
 else if(a==="lv"){W.lv=v;W.tr=null;W.done=1;buzz(6);TR[v]?go(2):to3()}
 else if(a==="cgo"){const t=$("#cv").value.trim();if(t){W.lv=t;W.tr=null;W.done=1;to3()}}
 else if(a==="tr"){W.tr=v;W.done=2;buzz(6);to3()}
 else if(a==="st"){go(i)}
 else if(a==="bk")go(W.step===3&&TR[W.lv]?2:1);
 else if(a==="g-"){W.g=Math.max(1,W.g-1);buzz(5);drawWz()}
 else if(a==="g+"){W.g=Math.min(99,W.g+1);buzz(5);drawWz()}
 else if(a==="c"){W.c=i;buzz(5);drawWz()}
 else if(a==="ok")submit()});
$("#wz").addEventListener("change",e=>{if(e.target.id==="sb")W.sub=e.target.value});
$("#wz").addEventListener("keydown",e=>{if(e.key==="Enter"&&e.target.id==="cv"){e.preventDefault();$('[data-act="cgo"]').click()}});
function submit(){
 const v={lv:W.lv,tr:W.tr||"",g:W.g,sub:W.sub,c:W.c,d:W.d};let id;
 if(W.id){Object.assign(S.find(s=>s.id===W.id),v);id=W.id}else{id=++uid;S.push({id,...v})}
 lastNew=id;save();buzz(12);$("#wz").close();render();toast(W.id?"تم تعديل القسم":"تمت إضافة القسم")}


/* ── modale de modification : onglets, liste d'élèves sans défilement imbriqué ── */
const COMBOS=[];CY.forEach(([,ls])=>ls.forEach(l=>TR[l]?TR[l].forEach(t=>COMBOS.push([l,t])):COMBOS.push([l,""])));
const parse=t=>[...new Set(t.split(/[؛;\n\r]+/).map(v=>v.replace(/\s+/g," ").trim()).filter(Boolean))];
let E={},E0="";
const eSnap=()=>JSON.stringify([E.lv,E.tr,E.g,E.c,E.st]);
function meta(){
 const n=E.st.length;
 $("#ecnt").textContent=n+" / 200";$("#ecnt").style.color=n>200?"#b4233f":"";
 $("#ebar").style.width=Math.min(100,n/2)+"%";$("#tcn").textContent=n||"";
 $("#esv").disabled=eSnap()===E0||n>200||!E.lv}
function drawEd(){
 const cy=cyOf(E.lv);
 $("#mh").style.cssText=vars(E.c);$("#tabs").style.cssText=vars(E.c);$("#p1").style.cssText=vars(E.c);
 $("#msub").textContent=cy>=0?CY[cy][0]:"مستوى مخصص";
 $("#elv").innerHTML=COMBOS.map(([l,t],i)=>`<option value="${i}"${l===E.lv&&t===E.tr?" selected":""}>${l}${t?" "+t:""}</option>`).join("");
 $("#elv").hidden=E.cus;$("#elc").hidden=!E.cus;if(E.cus)$("#elc").value=E.lv;
 $("#ecus").textContent=E.cus?"المستويات":"مستوى مخصص";
 $("#eg").textContent=E.g;
 $("#esw").innerHTML=PAL.map((_,i)=>`<button class="dotc${i===E.c?" on":""}" style="${vars(i)}" data-e="c" data-i="${i}" type="button" aria-label="لون ${i+1}" aria-pressed="${i===E.c}"></button>`).join("");
 meta()}
const grow=()=>{const t=$("#eta");if(t){t.style.height="auto";t.style.height=t.scrollHeight+2+"px"}};
function drawSt(){
 document.querySelectorAll(".mode button").forEach(b=>b.setAttribute("aria-pressed",+b.dataset.m===E.mode));
 const b=$("#ebody");
 if(E.mode){b.innerHTML=`<label class="lbl" for="eta">الأسماء الكاملة</label><textarea class="inp" id="eta" rows="5">${esc(E.st.join(" ؛ "))}</textarea><p class="hint2">افصل بين الأسماء بعلامة « ؛ » أو بسطر جديد.</p>`;grow()}
 else b.innerHTML=E.st.length?`<ol class="names">${E.st.map(v=>`<li>${esc(v)}</li>`).join("")}</ol>`:`<p class="no0">لا توجد أسماء بعد. اختر « تحرير » لإضافتها.</p>`}
function setTab(i){
 E.tab=i;$("#tabs").dataset.t=i;
 document.querySelectorAll("#tabs button").forEach(b=>b.setAttribute("aria-selected",+b.dataset.t===i));
 $("#p0").hidden=i!==0;$("#p1").hidden=i!==1;$("#ed .mb").scrollTop=0;if(i===1)drawSt()}
function openEd(x){
 E={id:x.id,lv:x.lv,tr:x.tr||"",g:x.g,c:x.c,st:(x.st||[]).slice(),tab:0,mode:(x.st&&x.st.length)?0:1,cus:!COMBOS.some(([l,t])=>l===x.lv&&t===(x.tr||""))};
 E0=eSnap();drawEd();setTab(0);$("#ed").showModal()}
$("#tabs").addEventListener("click",e=>{const b=e.target.closest("button");if(b){buzz(5);setTab(+b.dataset.t)}});
$("#ed").addEventListener("click",e=>{
 if(e.target===$("#ed"))return $("#ed").close();
 const b=e.target.closest("[data-e],[data-m]");if(!b)return;
 if(b.dataset.m!=null){E.mode=+b.dataset.m;drawSt();return}
 const a=b.dataset.e;
 if(a==="g-")E.g=Math.max(1,E.g-1);else if(a==="g+")E.g=Math.min(99,E.g+1);else if(a==="c")E.c=+b.dataset.i;
 buzz(5);drawEd()});
$("#elv").addEventListener("change",e=>{const c=COMBOS[+e.target.value];E.lv=c[0];E.tr=c[1];drawEd()});
$("#elc").addEventListener("input",e=>{E.lv=e.target.value.trim();E.tr="";meta()});
$("#ecus").onclick=()=>{E.cus=!E.cus;if(E.cus)E.tr="";else{E.lv=COMBOS[0][0];E.tr=COMBOS[0][1]}drawEd();if(E.cus)$("#elc").focus()};
$("#ebody").addEventListener("input",e=>{if(e.target.id!=="eta")return;E.st=parse(e.target.value);grow();meta()});
$("#esv").onclick=()=>{const x=S.find(s=>s.id===E.id);Object.assign(x,{lv:E.lv,tr:E.tr,g:E.g,c:E.c,st:E.st});lastNew=x.id;save();buzz(12);$("#ed").close();render();toast("تم تعديل القسم")};
$("#ecx").onclick=$("#mx").onclick=()=>$("#ed").close();
$("#edel").onclick=()=>{cur=E.id;$("#ed").close();document.querySelector('#sh [data-a="rm"]').click()};
swipe($("#ed"),$("#ed"),()=>$("#ed").close());

render();
setTimeout(()=>{$("#lst").classList.remove("fl");$("#hd").classList.remove("fl")},1600);
</script>
</body>
</html>

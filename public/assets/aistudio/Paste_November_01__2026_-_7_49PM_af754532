<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#faf8f4">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>أقسامي الدراسية</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Readex+Pro:wght@300..700&display=swap" rel="stylesheet">
<style>
/* ═══ 1. JETONS : couleurs, mesures, mouvement ═══ */
@property --a1{syntax:"<color>";inherits:true;initial-value:#f6d9bd}
@property --a2{syntax:"<color>";inherits:true;initial-value:#a8642a}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;scrollbar-width:thin;scrollbar-color:#ddd5c9 transparent}
::-webkit-scrollbar{width:.4rem;height:.4rem}::-webkit-scrollbar-thumb{background:#ddd5c9;border-radius:9px}
:root{--paper:#faf8f4;--ink:#2f2822;--mute:#7a7169;--brown:#7a5a49;--sand:#f0ebe3;
 --surface:color-mix(in srgb,var(--a1) 10%,#fffdfa);              /* surface des modales : suit l'ambiance */
 --ease:cubic-bezier(.22,.9,.3,1);--spring:cubic-bezier(.3,1.35,.5,1);
 --tap:max(44px,2.75rem);--card:4.8rem;--col:40rem;
 /* modales fluides : largeur et hauteur suivent l'écran sans paliers brusques */
 --sheet-w:min(100%,clamp(26rem,52vw,46rem));--pgs-w:min(100%,clamp(26rem,64vw,56rem));--bot-w:min(100%,clamp(24rem,42vw,34rem));
 --pgs-h:calc(100dvh - max(.8rem,env(safe-area-inset-top)));--pgs-h-d:min(94dvh,clamp(32rem,88dvh,54rem));
 --pad:clamp(1rem,4.6cqi,1.9rem);                                   /* marge intérieure : suit la largeur de la modale */
 --r-m:1.3rem;--r-l:1.8rem;--r-tight:.45rem;                       /* coin serré = signature Atelier */
 --sl:max(1.1rem,env(safe-area-inset-left));--sr:max(1.1rem,env(safe-area-inset-right));--sb:env(safe-area-inset-bottom);
 transition:--a1 .9s var(--ease),--a2 .9s var(--ease)}
html{font-size:clamp(15px,3.9vw,17px);-webkit-text-size-adjust:100%}
body{min-height:100dvh;background:color-mix(in srgb,var(--a1) 12%,var(--paper));color:var(--ink);font:400 1rem/1.6 "Readex Pro",system-ui,sans-serif}
button,input,select,textarea{font:inherit;color:inherit;touch-action:manipulation}
button{cursor:pointer}
.ic{width:1.3rem;height:1.3rem;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
:focus-visible{outline:2px solid color-mix(in srgb,var(--brown) 70%,transparent);outline-offset:3px}
[inert]{pointer-events:none}
/* fond dynamique : deux halos qui prennent la teinte du contexte (cours ouvert, couleur choisie…) */
.halo{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden}
.halo i{position:absolute;border-radius:50%;filter:blur(90px)}
.halo i:first-child{width:24rem;height:24rem;top:-10rem;right:-8rem;background:var(--a1);opacity:.55}
.halo i:last-child{width:26rem;height:26rem;bottom:-12rem;left:-10rem;background:color-mix(in srgb,var(--a2) 45%,#fff);opacity:.28}

/* ═══ 2. ACCUEIL ═══ */
.pg{max-width:var(--col);margin:0 auto;padding:max(1.6rem,env(safe-area-inset-top)) var(--sr) calc(7rem + var(--sb)) var(--sl)}
.hd{display:flex;align-items:center;justify-content:space-between;gap:.8rem;margin-bottom:2.2rem}
h1{font:600 clamp(1.5rem,6.4vw,2rem)/1.5 "Readex Pro",sans-serif;letter-spacing:-.01em}
.hact{display:flex;gap:.6rem}
.bot,.hplus{flex:none;width:var(--tap);height:var(--tap);border:0;border-radius:50%;display:grid;place-items:center;transition:transform .35s var(--spring)}
.bot{background:#ffffffb3}.bot svg{width:1.7rem;height:1.7rem}
.bot .e{transform-box:fill-box;transform-origin:center;transition:transform .15s}.bot.bl .e{transform:scaleY(.1)}
.hplus{background:var(--brown);color:#fff;display:none}
.bot:active,.hplus:active{transform:scale(.9)}
.grp{margin-top:2rem}.grp:first-child{margin-top:0}
.dn{font-weight:500;font-size:.84rem;color:var(--mute);margin:0 .3rem .7rem}
.cl{--bg:#fff;--bd:#eee;--t:var(--ink);--s:var(--mute);display:flex;align-items:center;min-height:var(--card);background:var(--bg);border-radius:var(--r-m);border-end-start-radius:var(--r-tight);margin-top:.6rem;transition:transform .4s var(--spring),box-shadow .3s}
.dn+.cl{margin-top:0}.cl:active{transform:scale(.985)}
.tx{flex:1;min-width:0;align-self:stretch;border:0;background:none;text-align:start;padding-block:.95rem;padding-inline:1.3rem .5rem;border-radius:inherit}
.nm{display:block;font-weight:600;font-size:1.05rem;line-height:1.5;color:var(--t);overflow-wrap:anywhere}
.lv{display:block;font-size:.8rem;color:var(--s)}
.mn{flex:none;margin-inline-end:.35rem;border:0;background:transparent;color:var(--s);width:var(--tap);height:var(--tap);border-radius:50%;display:grid;place-items:center;transition:background .25s,transform .3s var(--spring)}
.mn:active{background:#ffffffa6;transform:scale(.86)}
.vide{text-align:center;color:var(--mute);padding:3.6rem 1.2rem}.vide b{display:block;font-size:1.15rem;font-weight:600;color:var(--ink)}
.fab{position:fixed;left:var(--sl);bottom:calc(1.2rem + var(--sb));z-index:6;width:3.5rem;height:3.5rem;border:0;border-radius:1.2rem;border-end-start-radius:var(--r-tight);background:var(--brown);color:#fff;display:grid;place-items:center;box-shadow:0 8px 22px #7a5a4950;transition:transform .4s var(--spring)}
.fab svg{width:1.6rem;height:1.6rem;transition:transform .45s var(--spring)}
.fab:active{transform:scale(.9)}.fab:active svg{transform:rotate(90deg)}

/* ═══ 3. MODALES : socle commun (bandeau teinté, pastilles, feuilles) ═══ */
.hero{--bg:#fdeede;--bd:#f6d9bd;--t:#6b3a12;--s:#a8642a;padding:0 var(--pad) .9rem;background:linear-gradient(180deg,color-mix(in srgb,var(--bg) 85%,#fff),transparent);color:var(--t)}
.grab{height:1.6rem;display:grid;place-items:center;touch-action:none;flex:none}
.grab::before{content:"";width:2.4rem;height:.28rem;border-radius:4px;background:color-mix(in srgb,var(--s) 30%,transparent)}
.htop{display:flex;align-items:center;gap:.8rem}.htop>div{flex:1;min-width:0}
.hero h1,.hero h2{font:600 clamp(1.15rem,3.4cqi + .55rem,1.5rem)/1.4 "Readex Pro",sans-serif;color:var(--ink)}
.hero small{display:block;font-size:.78rem;color:var(--mute);line-height:1.3}
.stk{display:inline-block;margin:.45rem 0 0 .3rem;padding:.15rem .8rem;border-radius:99px;background:color-mix(in srgb,var(--s) 12%,transparent);color:var(--t);font-weight:500;font-size:.82rem}
.stk.alt{background:#ffffffb3}.stk[hidden]{display:none}
.x{flex:none;width:var(--tap);height:var(--tap);border:0;border-radius:50%;background:#ffffffb3;color:var(--ink);display:grid;place-items:center;transition:transform .3s var(--spring)}.x:active{transform:scale(.86)}
.wi{flex:none;width:2.9rem;height:2.9rem;border-radius:1rem;border-end-start-radius:var(--r-tight);background:#ffffffcc;color:var(--s);display:grid;place-items:center}
dialog{border:0;padding:0;max-width:none;color:var(--ink);background:var(--surface)}
dialog.sheet{margin:auto auto 0;width:var(--sheet-w);container:sheet/inline-size;max-height:min(94dvh,54rem);overflow:auto;overscroll-behavior:contain;border-radius:var(--r-l) var(--r-l) 0 0;box-shadow:0 -10px 50px #2f282233;transition:transform .25s var(--ease)}
dialog.sheet[open]{animation:sl .45s var(--spring)}
dialog::backdrop{background:#2f28224d;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
dialog[open]::backdrop{animation:fade .3s}
.in{padding:0 0 calc(1rem + var(--sb))}
.mr{display:flex;align-items:center;gap:.35rem}
.dock{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.2rem .6rem}
.dock>span{font-size:.82rem;font-weight:500;color:var(--mute)}
.sw{display:flex}
.dotc{position:relative;width:var(--tap);height:var(--tap);border:0;background:none;display:grid;place-items:center}
.dotc::before{content:"";width:2rem;height:2rem;border-radius:50%;background:var(--bg);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--s) 28%,transparent);transition:transform .35s var(--spring),box-shadow .2s}
.dotc.on::before{transform:scale(1.1);box-shadow:0 0 0 2px var(--surface),0 0 0 3.5px var(--s)}
.dotc.on::after{content:"✓";position:absolute;color:var(--t);font-weight:700;font-size:.9rem}
#ts{position:fixed;left:50%;bottom:calc(6rem + var(--sb));transform:translate(-50%,14px);display:flex;align-items:center;gap:.8rem;background:var(--ink);color:#fff;border-radius:99px;padding:.45rem .45rem .45rem 1.3rem;opacity:0;pointer-events:none;transition:opacity .25s,transform .4s var(--spring);z-index:40;font-weight:500;font-size:.92rem;max-width:calc(100% - 2rem)}
#ts.on{opacity:1;pointer-events:auto;transform:translate(-50%,0)}
#ts button{display:flex;align-items:center;gap:.4rem;border:0;border-radius:99px;background:var(--sand);color:var(--ink);padding:0 1rem;min-height:2.5rem;font-weight:600}
#ts .ic{width:1rem;height:1rem}

/* ═══ 4. ASSISTANT (bot) : panneau vertical, sombre et épuré ═══ */
dialog.bt{width:var(--bot-w);height:clamp(28rem,74dvh,40rem);max-height:94dvh;overflow:hidden;text-align:center;color:#f6efe7;border-radius:2rem 2rem 0 0;background:radial-gradient(120% 70% at 50% 0%,color-mix(in srgb,var(--a2) 34%,#1f1a16),#14110f 78%)}
dialog.bt[open]{display:flex;flex-direction:column;align-items:center}
dialog.bt::backdrop{background:#0d0a08a6}
.bt .grab::before{background:#ffffff40}
.bt[open]>:not(.grab){animation:rise .9s var(--ease) both}
.bt[open]>:nth-child(3){animation-delay:.08s}.bt[open]>:nth-child(4){animation-delay:.16s}.bt[open]>:nth-child(5){animation-delay:.24s}.bt[open]>:nth-child(6){animation-delay:.32s}
.orb{position:relative;flex:none;width:clamp(6.5rem,26cqi,10rem);height:clamp(6.5rem,26cqi,10rem);margin:.6rem auto 1.6rem}
.orb i{position:absolute;inset:0;border-radius:50%}
.orb i:nth-child(1){background:radial-gradient(circle at 35% 28%,#fff 0,color-mix(in srgb,var(--a2) 55%,#fff) 20%,var(--a2) 58%,color-mix(in srgb,var(--a2) 35%,#000) 100%);box-shadow:0 0 70px color-mix(in srgb,var(--a2) 55%,transparent),inset 0 -14px 30px #0006;animation:breathe 5s ease-in-out infinite}
.orb i:nth-child(2){inset:-1.1rem;background:conic-gradient(from 0deg,transparent 0 55%,color-mix(in srgb,var(--a1) 80%,transparent) 80%,transparent);filter:blur(16px);opacity:.75;animation:spin 9s linear infinite}
.orb i:nth-child(3){inset:-1.1rem;box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--a1) 30%,transparent);animation:ring 5s ease-out infinite}
.bk{font-size:.84rem;color:#f6efe79e;letter-spacing:.02em}
.bn{margin:.35rem 1.4rem 0;font-weight:600;font-size:clamp(1.2rem,5.2vw,1.55rem);line-height:1.5}
.bw{margin-top:1rem;font-size:1.02rem;color:#f6efe7b3}
.bw b{display:block;direction:ltr;font:300 clamp(3rem,15vw,4.2rem)/1.1 "Readex Pro",sans-serif;letter-spacing:-.02em;color:#fff;font-variant-numeric:tabular-nums}
.ba{margin-top:auto;width:100%;display:grid;gap:.2rem;padding:0 1.4rem calc(1.1rem + var(--sb))}
.bgo{min-height:3.4rem;border:0;border-radius:99px;background:#f6efe7;color:#1b1612;font-weight:600;font-size:1rem;box-shadow:0 0 44px color-mix(in srgb,var(--a2) 45%,transparent);transition:transform .3s var(--spring)}
.bgo:active{transform:scale(.96)}
.bsk{min-height:var(--tap);border:0;background:none;color:#f6efe78c;font-weight:500}

/* ═══ 5. MENU RAPIDE ═══ */
.qh{padding-bottom:.9rem}.qh .nm{font-size:1.15rem}
.qa{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;padding:.3rem var(--pad) 0}
.qa button{display:grid;justify-items:center;gap:.45rem;padding:.9rem .5rem .75rem;border:0;border-radius:var(--r-m);border-end-start-radius:var(--r-tight);background:#ffffffcc;font-weight:500;font-size:.92rem;transition:transform .35s var(--spring)}
.qa button:active{transform:scale(.94)}
.qb{width:2.9rem;height:2.9rem;border-radius:50%;display:grid;place-items:center}
.qb.ed{background:#ece9f7;color:#5d55a3}.qb.rm{background:#fbe6ee;color:#b04a72}
.cn2{display:block;width:calc(100% - 2*var(--pad));margin:.4rem var(--pad) 0;min-height:3rem;border:0;background:none;color:var(--mute);font-weight:500}

/* ═══ 6. FICHE CLASSE : tickets, date et actions sur une même ligne ═══ */
.ov{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;justify-content:center;background:#2f28224d;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px);opacity:0;visibility:hidden;transition:opacity .35s,visibility 0s .35s}
.ov.on{opacity:1;visibility:visible;transition:opacity .35s}
.pgs{position:relative;container:pgs/inline-size;width:var(--pgs-w);height:var(--pgs-h);overflow:auto;overscroll-behavior:contain;background:var(--surface);border-radius:var(--r-l) var(--r-l) 0 0;box-shadow:0 -12px 60px #2f282233;transform:translateY(100%);transition:transform .5s var(--ease)}
.ov.on .pgs{transform:none}
.pb{padding:.4rem var(--pad) calc(2rem + var(--sb)) var(--pad)}
.sl{font-weight:500;font-size:.95rem;color:var(--mute);margin:0 .3rem .4rem}
.ac{--bg:#fdeede;--bd:#f6d9bd;--t:#6b3a12;--s:#a8642a;background:var(--bg);border-radius:var(--r-m);border-end-start-radius:var(--r-tight);margin-top:.7rem;overflow:hidden}
.ac-h{display:flex;align-items:center;gap:.8rem;width:100%;min-height:3.9rem;border:0;background:none;padding:.4rem .9rem .4rem .5rem;text-align:start}
.ci{flex:none;width:2.6rem;height:2.6rem;border-radius:50%;background:#ffffffcc;color:var(--s);display:grid;place-items:center}
.ac-t{flex:1;font-weight:600;font-size:1rem;line-height:1.4;color:var(--t)}
.cnt{min-width:1.6rem;height:1.6rem;padding:0 .4rem;border-radius:99px;background:color-mix(in srgb,var(--s) 16%,transparent);color:var(--t);font:600 .76rem/1.6rem "Readex Pro";text-align:center}
.chv{flex:none;width:var(--tap);height:var(--tap);border-radius:50%;color:var(--t);display:grid;place-items:center;transition:transform .45s var(--spring),background .2s}
.ac.open .chv{transform:rotate(180deg);background:#ffffffa6}
.ac-b{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s var(--ease)}
.ac.open .ac-b{grid-template-rows:1fr}
.ac-i{overflow:hidden;min-height:0}.rs{padding:0 .6rem .7rem}
.tk{position:relative;background:#fff;border-radius:1.2rem;border-end-start-radius:var(--r-tight);padding:.9rem .75rem .75rem 1rem;margin-top:.5rem}
.tk:first-child{margin-top:0}
.as-t{font-weight:500;font-size:.97rem;line-height:1.55}
.due{display:block;font-weight:400;font-size:.8rem;color:var(--mute)}
.tr{display:flex;align-items:center;justify-content:space-between;gap:.6rem;margin-top:.7rem}
.lf{display:inline-flex;align-items:baseline;gap:.4rem;direction:ltr;padding:.4rem .85rem;border-radius:1rem;background:color-mix(in srgb,var(--s) 11%,transparent);color:var(--t)}
.lf b{font:600 1.15rem/1 "Readex Pro"}.lf small{font-size:.72rem;font-weight:500}
.acts{display:flex;gap:.35rem}
.tk.ch{margin-inline-start:1.5rem}
.tk.ch::before{content:"";position:absolute;inset-inline-start:-1.1rem;top:-.6rem;width:.85rem;height:1.9rem;border-inline-start:1.5px solid color-mix(in srgb,var(--s) 32%,transparent);border-bottom:1.5px solid color-mix(in srgb,var(--s) 32%,transparent);border-end-start-radius:.7rem}
.ab{position:relative;width:3rem;height:3rem;border:0;border-radius:1rem;display:grid;place-items:center;background:var(--sand);color:#3b2f28;transition:transform .3s var(--spring)}
.ab .ic{width:1.35rem;height:1.35rem}
.ab:active{transform:scale(.86)}
.ab.pk{background:#fde4ea;color:#c2255c}.ab.gn{background:#e2f3e7;color:#2f7a4d}
.ab.rd{background:#fbe9ec;color:#c2455c}.ab.wt{opacity:.55}
.bd{position:absolute;top:-.3rem;inset-inline-end:-.3rem;min-width:1.2rem;height:1.2rem;padding:0 .25rem;border-radius:99px;background:#c2255c;color:#fff;font:600 .66rem/1.2rem "Readex Pro";font-style:normal;text-align:center}
.no{padding:.8rem 1rem;border-radius:1.1rem;background:#ffffff80;color:var(--t);font-size:.86rem;text-align:center}

/* ═══ 7. ASSISTANT DE CRÉATION ═══ */
dialog.wz{height:clamp(30rem,82dvh,46rem);max-height:94dvh;overflow:hidden}
dialog.wz[open]{display:flex;flex-direction:column}
.wz .hero{flex:none}
.steps{display:flex;list-style:none;margin-top:.6rem}
.steps li{flex:1}
.steps button{display:grid;justify-items:center;align-content:start;gap:.25rem;width:100%;min-height:var(--tap);border:0;background:none;padding:0;font-size:.78rem;font-weight:500;color:var(--mute)}
.steps i{width:2.1rem;height:2.1rem;border-radius:50%;background:#ffffffb3;display:grid;place-items:center;font:600 .85rem "Readex Pro";font-style:normal;color:var(--ink);transition:transform .4s var(--spring),background .3s}
.steps i .ic{width:.95rem;height:.95rem;stroke-width:3}
.steps [aria-current] i{background:var(--brown);color:#fff;transform:scale(1.12)}
.steps [aria-current]{color:var(--ink);font-weight:600}.steps .ok i{background:#fff;color:#2f7a4d}
.steps button:disabled{opacity:.45}
.wb{flex:1;min-height:0;overflow:auto;padding:.5rem var(--pad) 1rem;overscroll-behavior:contain}
.wb.an>*{animation:rise .4s var(--ease) both}
.wf{display:grid;gap:.4rem;padding:.4rem var(--pad) calc(.8rem + var(--sb));flex:none}
.wf button{min-height:3rem;border:0;border-radius:1.1rem;font-weight:600;background:none;color:var(--mute);padding:0 1rem;display:flex;align-items:center;justify-content:center;gap:.4rem;transition:transform .3s var(--spring)}
.wf button:active{transform:scale(.95)}
.wf .pri{flex:1;background:var(--brown);color:#fff}.wf .gh,.wf .bk{flex:none}
.seg{display:grid;grid-template-columns:repeat(3,1fr);gap:.2rem;background:var(--sand);padding:.25rem;border-radius:1.1rem;margin-top:.5rem}
.seg button{min-height:var(--tap);border:0;background:none;border-radius:.85rem;font-size:.76rem;font-weight:500;color:var(--mute);padding:.2rem .3rem;line-height:1.3;transition:background .25s}
.seg [aria-pressed=true]{background:#fff;color:var(--ink);box-shadow:0 1px 4px #2f282214;font-weight:600}
.lb{display:flex;align-items:center;justify-content:space-between;margin:.8rem 0 .4rem}.lb b{font-weight:600;font-size:1rem}
.lnk{border:0;background:none;color:var(--brown);font-size:.82rem;font-weight:500;min-height:var(--tap);padding:0 .3rem}
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(9.5rem,1fr));gap:.5rem}.tiles.col{grid-template-columns:1fr}
.tile{display:flex;align-items:center;justify-content:space-between;gap:.5rem;min-height:3.5rem;padding:.4rem .55rem .4rem 1rem;border:0;border-radius:var(--r-m);border-end-start-radius:var(--r-tight);background:var(--bg);color:var(--t);font-weight:600;font-size:.98rem;line-height:1.3;text-align:start;transition:transform .35s var(--spring),box-shadow .25s}
.tile .ar{flex:none;width:2.2rem;height:2.2rem;border-radius:50%;background:#ffffffb3;display:grid;place-items:center}
.tile .ic{width:1rem;height:1rem}
.tile:active{transform:scale(.97)}.tile.on{box-shadow:0 0 0 2px color-mix(in srgb,var(--s) 60%,transparent)}
.cust{display:flex;gap:.5rem}
.cust input,.inp{width:100%;height:3.1rem;padding:0 1.1rem;border:0;background:#ffffffd9;border-radius:1rem;font:500 16px "Readex Pro",sans-serif;color:var(--ink);transition:box-shadow .2s,background .2s}
.cust input{flex:1;min-width:0}
.cust input:focus,.inp:focus{outline:0;background:#fff;box-shadow:0 0 0 3px color-mix(in srgb,var(--brown) 22%,transparent)}
.cust button{border:0;border-radius:1rem;background:var(--brown);color:#fff;font-weight:600;padding:0 1.2rem}
.c3{background:var(--bg);border-radius:var(--r-m);border-end-start-radius:var(--r-tight);padding:1.1rem;margin-top:.5rem;color:var(--t);transition:background-color .5s}
.c3 small{display:block;color:var(--s);font-size:.8rem;line-height:1.4}
.c3 .sel{display:block;font-weight:600;font-size:1.2rem;line-height:1.4}
.lb2{font-weight:500;font-size:.88rem;margin:1rem 0 .5rem}
.sp{display:flex;align-items:center;justify-content:space-between;background:#ffffff99;border-radius:1.3rem;padding:.3rem}

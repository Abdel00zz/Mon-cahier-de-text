{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignore": ["public/sw.js"],
  "ignoreBinaries": ["whoami.exe", "icacls.exe"],
  "ignoreDependencies": [
    "@fontsource-variable/cairo",
    "@fontsource-variable/dm-sans",
    "@fontsource-variable/newsreader",
    "@fontsource-variable/roboto-slab",
    "@fontsource-variable/rubik",
    "@fontsource-variable/source-sans-3",
    "@fontsource/lato",
    "firebase-tools"
  ],
  "entry": [
    "src/admin/index.tsx",
    "api/admin.ts",
    "api/auth.ts",
    "api/calendar.ts",
    "api/messages.ts",
    "api/notify.ts",
    "api/official-events.ts",
    "api/sync.ts",
    "tests/test-*.ts",
    "tests/firebase-emulator.integration.ts",
    "scripts/firebase/*.ts",
    "scripts/firebase/*.mjs",
    "scripts/benchmarks/benchmark-*.ts",
    "scripts/benchmarks/baseline.mjs",
    "scripts/guide-preview/main.tsx",
    "scripts/auth-preview/main.tsx",
    "scripts/print-preview/main.tsx",
    "scripts/showcase-preview/main.tsx",
